#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int X, Y, Z;
        cin >> X >> Y >> Z;

        int required = X * Y;
        int available = Z * 24 * 60;

        if (required <= available)
            cout << "YES\n";
        else
            cout << "NO\n";
    }

    return 0;
}
#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        string s;
        cin >> s;
        for (char & c: s) {
            if (c == 'A')
                c = 'T';
            else if (c == 'T')
                c = 'A';
            else if (c == 'C')
                c = 'G';
            else if (c == 'G')
                c = 'C';
        }
        cout << s << endl;
    }
    return 0;

}
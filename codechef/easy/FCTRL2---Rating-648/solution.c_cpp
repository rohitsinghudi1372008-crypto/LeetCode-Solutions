#include <bits/stdc++.h>
using namespace std;

void factorial(int n) {
    int a[200];
    int size = 1;
    a[0] = 1;

    for (int i = 2; i <= n; i++) {
        int carry = 0;

        for (int j = 0; j < size; j++) {
            int x = a[j] * i + carry;
            a[j] = x % 10;
            carry = x / 10;
        }

        while (carry) {
            a[size] = carry % 10;
            carry /= 10;
            size++;
        }
    }

    for (int i = size - 1; i >= 0; i--)
        cout << a[i];

    cout << endl;
}

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;
        factorial(n);
    }

    return 0;
}
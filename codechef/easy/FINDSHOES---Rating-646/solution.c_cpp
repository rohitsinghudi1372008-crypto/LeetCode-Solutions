#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n, m;
        cin >> n >> m;
        if (m == 0) {
            cout << n * 2 << endl;
        } else if (n < m) {
            cout << min(n, m) << endl;
        } else {
            cout << n - m + n << endl;
        }
    }
    return 0;
}
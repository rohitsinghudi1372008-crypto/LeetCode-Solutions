#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        if (n <= 10) {
            cout << "Lower Double" << endl;
        } else if (n <= 15) {
            cout << "Lower single" << endl;
        }
        else if (n <= 25) {
            cout << "upper Double" << endl;
        }
        else {
            cout << "upper single" << endl;
        }
    }
}

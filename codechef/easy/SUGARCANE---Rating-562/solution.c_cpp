#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int A, B, X, Y;
        cin >> A >> B >> X >> Y;

        if (X * Y >= A * B)
            cout << "Yes" << endl;
        else
            cout << "No" << endl;
    }

    return 0;
}
#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    vector<int>cnt(31,0);
	    for(int i=0;i<n; i++){
	int x;
	cin>>x;
	int bit=31-__builtin_clz(x);
	cnt[bit]++;
	    
	    
	}
	int ans=0;
	for(int i=0;i<31; i++){
	    ans=max(ans,cnt[i]);
	}
	cout<<ans<<endl;

}
return 0;
}
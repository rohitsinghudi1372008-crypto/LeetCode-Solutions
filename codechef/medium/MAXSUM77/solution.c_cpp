#include <bits/stdc++.h>
using namespace std;

int main() {
 int t;
 cin>>t;
 while(t--){
     int n,k;
     cin>>n>>k;
     vector<int>a(n);
     for(int i=0; i<n; i++){
         cin>>a[i];
         
     }
     int len =n-k;
     long long sum=0;
     for(int i=0; i<len; i++){
         sum +=a[i];
         
     }
     long long ans=sum;
     for(int i=len; i<n; i++){
         sum+=a[i];
         sum-=a[i-len];
         ans=max(ans,sum);
     }
     cout<<ans<<endl;
 }
 return 0;

}

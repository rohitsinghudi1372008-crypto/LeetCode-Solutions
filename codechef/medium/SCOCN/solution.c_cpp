#include <bits/stdc++.h>

using namespace std;

int main() {
        int n;
        cin >> n;
        vector < int > a(n);
        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }
        int x;
        cin >> x;
        int count = 0;
        for (int i = 0; i < n; i++) {
            if (a[i] == x) {
                count++;

            }
            if (count == 2) {
                cout << i;
                return 0;
            }
        }


        if (count == 0) {
            cout << -1;
        } else {
            cout << -2;
        }
            return 0;
        }
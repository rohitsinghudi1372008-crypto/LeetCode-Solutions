#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n, m, k;
        cin >> n >> m >> k;
        vector < bool > occupied(n + 1, false);
        for (int i = 0; i < m; i++) {
            int x;
            cin >> x;
            occupied[x] = true;
        }
        for (int i = 0; i < k; i++) {
            for (int seat = 1; seat <= n; seat++) {
                if (!occupied[seat]) {
                    cout << seat << " ";
                    occupied[seat] = true;
                    break;
                }
            }
        }
        cout << endl;
    }
    return 0;

}
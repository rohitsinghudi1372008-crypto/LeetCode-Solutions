#include <bits/stdc++.h>
using namespace std;

int main() {
int t;
cin>>t;
while(t--){
    int n,k;
    cin>>n>>k;
    for(int i=0; i<n; i++){
        int x;
        cin>>x;
        long lon fact =1;
        for(int i=1; i<=k; i++){
            fact=fact*i%MOD;
        }
        long long ans =fact*power(k,n-k)%MOD;
        cout<<ans<<endl;
    }
    return 0;
}

}
